# API Keys - 各サービスでAPIキーを取得し、ここに設定してください
# 詳細は README.md を参照

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ホラー動画パイプライン (horror_pipeline.py) 用
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Pexels API (画像取得・完全無料)
# 取得先: https://www.pexels.com/api/  ← 登録するだけで即取得可能
PEXELS_API_KEY=your-pexels-api-key-here

# Anthropic API (Claudeでスクリプト構造化・任意)
# 未設定でもシンプル分割で動作する
# 取得先: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AI映像生成 (generate-ai-video.mjs) 用 - 任意
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Google Gemini API (Veo 3.1 動画生成)
# 取得先: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Runway API (Gen4.5 動画生成) - オプション
# 取得先: https://app.runwayml.com/settings/api-keys
RUNWAY_API_KEY=your-runway-api-key-here

# ElevenLabs API (高品質音声合成・月10,000文字まで無料)
# 未設定の場合は gTTS（完全無料）を自動使用
# 取得先: https://elevenlabs.io/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
